# Development-only credentials. Copy to .env; do not use them in production.
CARDREPORT_DATABASE_URL=postgresql://cardreport:local-db-only@127.0.0.1:15432/cardreport
CARDREPORT_S3_ENDPOINT=http://127.0.0.1:18333
CARDREPORT_S3_ACCESS_KEY=cardreport-local
CARDREPORT_S3_SECRET_KEY=local-storage-only
CARDREPORT_S3_BUCKET=cardreport
CARDREPORT_S3_PREFIX=cardreport/
# All application tunables below also pass through Compose.
# Compose keeps its bundled DB/S3 endpoints and credentials; the values above
# are for native API debugging. Do not use production credentials in this stack.
CARDREPORT_S3_REGION=us-east-1
CARDREPORT_DB_POOL_SIZE=8
CARDREPORT_IO_TIMEOUT=5
CARDREPORT_DB_CONNECT_TIMEOUT=5
CARDREPORT_DB_STATEMENT_TIMEOUT=5
CARDREPORT_DB_LOCK_TIMEOUT=3
CARDREPORT_INPUT_LIMIT=16777216
CARDREPORT_DATA_MAX_ROWS=2000
CARDREPORT_DATA_MAX_CELLS=100000
CARDREPORT_OUTPUT_LIMIT=33554432
CARDREPORT_DATA_VIEW_SLOTS=2
CARDREPORT_UPLOAD_SLOTS=4
CARDREPORT_UPLOAD_TIMEOUT=120
CARDREPORT_UPLOAD_IDLE_TIMEOUT=30
CARDREPORT_BACKLOG_LIMIT=1000
CARDREPORT_ADMISSION_ENABLED=true
CARDREPORT_WORKER_CONCURRENCY=2
CARDREPORT_LEASE_SECONDS=60
CARDREPORT_HEARTBEAT_SECONDS=15
CARDREPORT_ATTEMPT_TIMEOUT=120
CARDREPORT_RENDER_TIMEOUT=300
CARDREPORT_STARTUP_RENDER_TIMEOUT=30
CARDREPORT_STARTUP_TIMEOUT=75
CARDREPORT_HEALTH_MAX_AGE=60
CARDREPORT_CLEANUP_GRACE=5
CARDREPORT_SHUTDOWN_GRACE=130
CARDREPORT_MAX_ATTEMPTS=3
CARDREPORT_POLL_SECONDS=1
CARDREPORT_QUEUE_MAX_AGE=3600
CARDREPORT_RETRY_DELAY=5
CARDREPORT_RETRY_MAX_DELAY=120
CARDREPORT_RESULT_RETENTION=86400
CARDREPORT_METADATA_RETENTION=604800
CARDREPORT_DOWNLOAD_TIMEOUT=120
CARDREPORT_ORPHAN_GRACE=900
CARDREPORT_MAINTENANCE_INTERVAL=30
CARDREPORT_MAINTENANCE_BATCH_SIZE=100
CARDREPORT_TEMP_ROOT=/tmp/cardreport-worker
CARDREPORT_IMAGE_ID=development

# Compose-only settings. Stop grace must exceed CARDREPORT_SHUTDOWN_GRACE.
CONTAINER_STOP_GRACE=140s
WORKER_START_PERIOD=30s
POSTGRES_PORT=15432
S3_PORT=18333
API_PORT=18000

# Optional published image; use --no-build when starting it.
# CARDREPORT_SERVER_IMAGE=ghcr.io/arch7tect/cardreport-server:0.4.2
